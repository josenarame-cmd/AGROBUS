# ==============================================================
# AGROBUS — AI Soil Analysis Service
# .gitignore
# ==============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Environment files
.env
*.env.local

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ML / model artifacts (too large for git — use Git LFS or cloud storage)
models/saved/*.pth
models/saved/*.pt
models/saved/*.onnx

# Dataset (raw images — do not commit to git)
dataset/raw/
dataset/processed/

# Evaluation outputs (regenerated by evaluate.py)
evaluation/confusion_matrix.png
evaluation/training_curves.png
evaluation/roc_curves.png
evaluation/evaluation_report.txt
evaluation/training_log.csv

# Prediction output
prediction_result.json

# Kaggle credentials
kaggle.json

# OS
.DS_Store
Thumbs.db
desktop.ini
